[
  {
    "name": "search",
    "description": "搜索 X/Twitter 推文",
    "loginRequired": "optional",
    "parameters": [
      { "name": "--query", "type": "string", "required": true, "description": "搜索关键词" }
    ],
    "examples": [{ "cmd": "xbrowser twitter search --query \"OpenAI\"", "description": "搜索 OpenAI 相关推文" }]
  },
  {
    "name": "profile",
    "description": "获取 X/Twitter 用户资料",
    "loginRequired": "none",
    "parameters": [
      { "name": "--username", "type": "string", "required": true, "description": "用户名（不含 @）" }
    ],
    "examples": [{ "cmd": "xbrowser twitter profile --username \"elonmusk\"", "description": "获取 Elon Musk 资料" }]
  },
  {
    "name": "timeline",
    "description": "获取 X/Twitter 用户最新推文",
    "loginRequired": "optional",
    "parameters": [
      { "name": "--username", "type": "string", "required": true, "description": "用户名（不含 @）" }
    ],
    "examples": [{ "cmd": "xbrowser twitter timeline --username \"elonmusk\"", "description": "获取 Elon Musk 最新推文" }]
  },
  {
    "name": "replies",
    "description": "获取推文回复",
    "loginRequired": "optional",
    "parameters": [
      { "name": "--id", "type": "string", "required": true, "description": "推文 ID" }
    ],
    "examples": [{ "cmd": "xbrowser twitter replies --id \"123456789\"", "description": "获取推文回复" }]
  },
  {
    "name": "liked",
    "description": "获取用户点赞的推文",
    "loginRequired": "optional",
    "parameters": [
      { "name": "--username", "type": "string", "required": true, "description": "用户名（不含 @）" }
    ],
    "examples": [{ "cmd": "xbrowser twitter liked --username \"elonmusk\"", "description": "获取 Elon Musk 点赞" }]
  },
  {
    "name": "search-image",
    "description": "搜索 Twitter/X 图片",
    "loginRequired": "optional",
    "parameters": [
      { "name": "--query", "type": "string", "required": true, "description": "搜索关键词" }
    ],
    "examples": [{ "cmd": "xbrowser twitter search-image --query \"cat\"", "description": "搜索猫图片" }]
  },
  {
    "name": "post",
    "description": "在 X/Twitter 发布推文，支持最多四张图片",
    "loginRequired": "required",
    "parameters": [
      { "name": "--text", "type": "string", "required": true, "description": "推文内容（最多280字符）" },
      { "name": "--image", "type": "string", "required": false, "description": "单张图片的绝对路径" },
      { "name": "--images", "type": "string", "required": false, "description": "多张图片的绝对路径 CSV（最多4张）" }
    ],
    "examples": [{ "cmd": "xbrowser twitter post --text \"Hello World!\"", "description": "发布一条推文" }]
  },
  {
    "name": "reply",
    "description": "回复指定推文，支持图片附件",
    "loginRequired": "required",
    "parameters": [
      { "name": "--tweetUrl", "type": "string", "required": true, "description": "推文 URL" },
      { "name": "--text", "type": "string", "required": true, "description": "回复内容" },
      { "name": "--image", "type": "string", "required": false, "description": "单张图片的绝对路径" },
      { "name": "--images", "type": "string", "required": false, "description": "多张图片的绝对路径 CSV（最多4张）" }
    ],
    "examples": [{ "cmd": "xbrowser twitter reply --tweetUrl \"https://x.com/user/status/123\" --text \"Great!\"", "description": "回复推文" }]
  },
  {
    "name": "retweet",
    "description": "转发或引用指定推文",
    "loginRequired": "required",
    "parameters": [
      { "name": "--tweetUrl", "type": "string", "required": true, "description": "推文 URL" },
      { "name": "--quote", "type": "boolean", "required": false, "description": "是否引用转发" },
      { "name": "--quoteText", "type": "string", "required": false, "description": "引用转发时的文字" }
    ],
    "examples": [{ "cmd": "xbrowser twitter retweet --tweetUrl \"https://x.com/user/status/123\"", "description": "转发推文" }]
  },
  {
    "name": "like",
    "description": "点赞指定推文",
    "loginRequired": "required",
    "parameters": [
      { "name": "--tweetUrl", "type": "string", "required": true, "description": "推文 URL" }
    ],
    "examples": [{ "cmd": "xbrowser twitter like --tweetUrl \"https://x.com/user/status/123\"", "description": "点赞推文" }]
  },
  {
    "name": "delete",
    "description": "按推文 ID 或 URL 删除自己的推文",
    "loginRequired": "required",
    "parameters": [
      { "name": "--tweet", "type": "string", "required": true, "description": "推文 ID 或推文 URL" }
    ],
    "examples": [{ "cmd": "xbrowser twitter delete --tweet 1234567890", "description": "按 ID 删除推文" }]
  }
]
