{
  "name": "xbrowser-plugin-twitter",
  "version": "2.0.0",
  "description": "X (Twitter) 数据采集插件 - 支持推文搜索、用户资料、时间线、回复等功能，针对高影响力账号优化",
  "main": "index.ts",
  "keywords": [
    "xbrowser",
    "xbrowser-plugin",
    "twitter",
    "x",
    "social-media",
    "scraper",
    "elonmusk",
    "trump",
    "data-collection"
  ],
  "author": "XBrowser Team",
  "license": "MIT",
  "xbrowser": {
    "site": "https://x.com",
    "requiresLogin": false,
    "commands": [
      "search",
      "profile",
      "timeline",
      "timeline-advanced",
      "tweets",
      "replies"
    ]
  },
  "dependencies": {
    "zod": "^3.24.0"
  },
  "peerDependencies": {
    "@dyyz1993/xcli-core": ">=1.0.0"
  }
}
