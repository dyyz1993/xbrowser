{
  "name": "xbrowser-plugin-npm",
  "version": "1.1.0",
  "main": "index.ts",
  "type": "module",
  "keywords": ["xbrowser", "xbrowser-plugin", "npm", "registry", "access-token"],
  "dependencies": {
    "zod": "^3.24.0"
  },
  "peerDependencies": {
    "@dyyz1993/xcli-core": ">=1.0.0"
  },
  "xbrowser": {
    "name": "npm",
    "slug": "npm",
    "version": "1.1.0",
    "author": "dyyz1993",
    "description": "npm registry 查询（search/package/downloads）+ 访问令牌全生命周期管理（登录创建 Granular Token / 列出 / 撤销，chrome-bridge 通道）",
    "site": "https://www.npmjs.com",
    "requiresLogin": true,
    "tags": ["npm", "registry", "token", "publish"],
    "sites": ["https://www.npmjs.com"],
    "commands": [
      "search",
      "package",
      "downloads",
      "create-token",
      "list-tokens",
      "delete-token"
    ]
  }
}
