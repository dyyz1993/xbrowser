{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "baseUrl": "../../",
    "paths": {
      "zod": ["node_modules/zod/v4/index.d.cts"]
    }
  },
  "include": ["./**/*.ts", "../types/**/*"],
  "exclude": ["node_modules"]
}
