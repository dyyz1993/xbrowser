# ── data/ 下的临时爬虫输出 ─────────────────────────
/data/geo/batch2/
/data/geo/v2/
/data/geo/v3/
/data/geo/*-results.json
/data/geo/clothing-ranking/
/data/test-imports/

# ── docs/ 下的临时/规划文档 ──────────────────────────
docs/debug-*
docs/plans/*
# 例外：长期追踪的 SPEC 文档必须入库
!docs/plans/*-spec.md

# ── scripts/：只保留 release/ 与白名单里的工具，其余一次性脚本一律不入库 ──
# AGENTS.md §1：自动化脚本 → 插件（.xcli/plugins/<site>/），不是 scripts/。
# lint-scripts/check-architecture.mjs 对「已跟踪的 scripts/ 文件」做同一份白名单校验。
/scripts/*
!/scripts/release/
!/scripts/arena-round.sh
!/scripts/check-editors.ts
!/scripts/check-logins.ts
!/scripts/inline-stealth.mjs
!/scripts/mcp-smoke.mjs
.learnings/
