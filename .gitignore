# ── Dependencies & Build ───────────────────────────────
node_modules/
dist/
*.tgz

# ── Environment & Secrets ──────────────────────────────
.env

# ── OS & Editor ─────────────────────────────────────────
.DS_Store
*.log

# ── Runtime & Cache ─────────────────────────────────────
.xcli/storage/
recordings/
# 测试夹具里的录制文件必须入库（上面的目录级忽略会误伤 tests/**/fixtures）
!/tests/**/fixtures/**/recordings/
!/tests/**/fixtures/**/recordings/**
coverage/
output/

# ── Project state / metadata tools ─────────────────────
.codenomad/
.opencode/
.zcode/
.video_agent/

# ── Archive (历史归档) ──────────────────────────────
.archive/

# ── Plugin local node_modules & package.json ───────────
.xcli/plugins/node_modules/
.xcli/plugins/package.json

# ── Root-level artifacts (禁止根目录零散文件) ──────
# 脚本
/check-*.ts
/search-*.ts
/explore-*.ts
/crawl-*.ts
/generate-*.ts
/extract-*.ts
/direct-api-*.ts
/province-*.ts
/run-checklist.mjs
/open-qianwen.mjs
/_test_bing.js
/test-*.js
/test-*.mjs
/test-cdp-*.mjs
# 数据 & 报告
/ai-test-results.json
/checklist-progress.json
/cmf-analysis-dashboard.html
/douyin_works_sample.json
/links.json
/stats-*.png
/ctrip-report.html
