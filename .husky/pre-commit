set -e

echo "🔍 [pre-commit] Running typecheck..."
npx tsc --noEmit
if [ $? -ne 0 ]; then
  echo "❌ TypeScript typecheck failed. Fix all type errors before committing."
  exit 1
fi
echo "✅ Typecheck passed"

echo "🔍 [pre-commit] Running ESLint..."
npx eslint src/ bin/ --ext .ts --max-warnings 0
if [ $? -ne 0 ]; then
  echo "❌ ESLint check failed. Fix all errors and warnings before committing."
  exit 1
fi
echo "✅ ESLint passed (0 warnings)"

ANY_COUNT=$(grep -r '\bany\b' src/ --include='*.ts' -c 2>/dev/null | awk -F: '{sum+=$NF} END {print sum+0}')
if [ "$ANY_COUNT" -gt 100 ]; then
  echo "❌ Commit rejected: Found $ANY_COUNT 'any' type usages in src/ (max allowed: 100)"
  echo "   Please reduce 'any' usage before committing."
  exit 1
fi
echo "✅ any check passed: $ANY_COUNT/100"

echo "🔍 [pre-commit] Checking command param consumption..."
node lint-scripts/check-command-params.mjs
if [ $? -ne 0 ]; then
  echo "❌ Command param check failed. Fix unconsumed parameters before committing."
  echo "   → See lint-scripts/RULES.md for guidelines."
  exit 1
fi
echo "✅ Command param check passed"

echo "🔍 [pre-commit] Checking help auto-generation..."
node lint-scripts/check-help-auto-gen.mjs
if [ $? -ne 0 ]; then
  echo "❌ Help auto-gen check failed. Do not use hand-written help files."
  echo "   → Use helpGenerator from @dyyz1993/xcli-core instead."
  echo "   → See lint-scripts/RULES.md for guidelines."
  exit 1
fi
echo "✅ Help auto-gen check passed"

echo "🔍 [pre-commit] Checking result schema..."
node lint-scripts/check-result-schema.mjs
if [ $? -ne 0 ]; then
  echo "❌ Result schema check failed. Add result schema to all commands."
  echo "   → See lint-scripts/RULES.md for guidelines."
  exit 1
fi
echo "✅ Result schema check passed"

echo "🔍 [pre-commit] Checking output convention..."
node lint-scripts/check-output-convention.mjs
if [ $? -ne 0 ]; then
  echo "❌ Output convention check failed. Fix violations before committing."
  echo "   → See lint-scripts/RULES.md for guidelines."
  exit 1
fi
echo "✅ Output convention check passed"

echo "🔍 [pre-commit] Checking plugin metadata..."
node lint-scripts/check-plugin-metadata.mjs
if [ $? -ne 0 ]; then
  echo "❌ Plugin metadata check failed. Add package.json with xbrowser metadata."
  echo "   → See lint-scripts/RULES.md for guidelines."
  exit 1
fi
echo "✅ Plugin metadata check passed"

echo "🔍 [pre-commit] Checking plugin code quality..."
node lint-scripts/check-plugin-code.mjs
if [ $? -ne 0 ]; then
  echo "❌ Plugin code check failed. Fix ok()/fail() calls and syntax issues."
  echo "   → ok()/fail() 参数必须用对象花括号: ok({ data: ... }, tips)"
  echo "   → 不允许裸 return { data: null }，必须用 ok()/fail()"
  exit 1
fi
echo "✅ Plugin code check passed"

echo "✅ [pre-commit] All checks passed!"
