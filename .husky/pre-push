set -e

echo "🧪 [pre-push] Quick validation (typecheck + lint + smoke test)..."
echo "   Full test suite runs in CI (GitHub Actions)."

# 1. Typecheck (catches type errors fast)
npm run typecheck
if [ $? -ne 0 ]; then
  echo "❌ Typecheck failed."
  exit 1
fi

# 2. Lint (catches style/pattern violations fast)
npm run lint
if [ $? -ne 0 ]; then
  echo "❌ Lint failed."
  exit 1
fi

# 3. Build (catches ESM/packaging bugs like v1.0.3 incident)
npm run build
if [ $? -ne 0 ]; then
  echo "❌ Build failed."
  exit 1
fi

# 4. Smoke test — CLI must start (catches ESM require() crashes)
node dist/cli.js --version > /dev/null
if [ $? -ne 0 ]; then
  echo "❌ Smoke test failed: CLI cannot start."
  exit 1
fi
node -e "import('./dist/index.js').then(() => {}).catch(() => process.exit(1))"
if [ $? -ne 0 ]; then
  echo "❌ Smoke test failed: module import failed."
  exit 1
fi

echo "✅ [pre-push] Quick validation passed! (typecheck + lint + build + smoke)"
echo "   Full test suite will run in CI."
