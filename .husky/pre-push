set -e

echo "🧪 [pre-push] Quick validation (typecheck + lint + build + smoke test)..."
echo "   Full test suite runs in CI (GitHub Actions)."

# 1. Typecheck
npm run typecheck || { echo "❌ Typecheck failed."; exit 1; }

# 2. Lint
npm run lint || { echo "❌ Lint failed."; exit 1; }

# 3. Build
npm run build || { echo "❌ Build failed."; exit 1; }

# 4. Smoke test (stdin from /dev/null to prevent git push refs interference)
node dist/cli.js --version < /dev/null > /dev/null || { echo "❌ Smoke test: CLI failed to start."; exit 1; }
node -e "import('./dist/index.js').then(() => {}).catch(() => process.exit(1))" < /dev/null || { echo "❌ Smoke test: module import failed."; exit 1; }

echo "✅ [pre-push] Quick validation passed! (typecheck + lint + build + smoke)"
echo "   Full test suite will run in CI."
