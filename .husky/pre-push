set -e

echo "🧪 [pre-push] Running full test suite..."
# 加大 worker 内存：本仓库 180+ 测试文件，forks worker 复用会累积内存导致 OOM
NODE_OPTIONS="--max-old-space-size=8192" npx vitest run --exclude='tests/e2e/**' --exclude='tests/human-interaction.test.ts' --exclude='tests/websocket-server.test.ts' --exclude='tests/screencast.test.ts' --exclude='tests/cli/daemon-session.test.ts'
if [ $? -ne 0 ]; then
  echo "❌ Tests failed. All tests must pass before pushing."
  exit 1
fi
echo "✅ [pre-push] All tests passed!"
