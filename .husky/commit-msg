MSG=$(cat "$1")

if ! echo "$MSG" | grep -qE "^(feat|fix|docs|style|refactor|test|chore|perf|ci|build|revert)(\(.+\))?: .{1,80}"; then
  echo "❌ Invalid commit message format."
  echo ""
  echo "Expected format: <type>(<scope>): <subject>"
  echo ""
  echo "Types: feat, fix, docs, style, refactor, test, chore, perf, ci, build, revert"
  echo "Subject: 1-80 chars, no trailing period"
  echo ""
  echo "Examples:"
  echo "  feat(auth): add login support"
  echo "  fix: resolve null pointer in parser"
  echo "  docs: update API documentation"
  exit 1
fi

LENGTH=$(echo "$MSG" | head -1 | wc -c | tr -d ' ')
if [ "$LENGTH" -gt 100 ]; then
  echo "❌ Commit message first line too long ($LENGTH chars, max 100)."
  exit 1
fi

echo "✅ Commit message format valid"
