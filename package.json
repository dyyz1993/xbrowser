{
  "name": "@dyyz1993/xbrowser",
  "version": "0.3.0",
  "description": "A self-contained browser automation CLI tool — navigate, click, fill forms, extract data, record & replay sessions via YAML scripts",
  "type": "module",
  "bin": {
    "xbrowser": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "browser",
    "automation",
    "cli",
    "playwright",
    "cdp",
    "scraper",
    "puppeteer",
    "web-testing",
    "browser-automation",
    "record-replay"
  ],
  "author": "dyyz1993",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dyyz1993/xbrowser.git"
  },
  "bugs": {
    "url": "https://github.com/dyyz1993/xbrowser/issues"
  },
  "homepage": "https://github.com/dyyz1993/xbrowser#readme",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/ bin/ --ext .ts",
    "typecheck": "tsc --noEmit",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "npm run typecheck && npm run lint && npm run build && npm test"
  },
  "dependencies": {
    "@dyyz1993/xcli-core": "^0.6.0",
    "playwright": "^1.59.0",
    "ws": "^8.20.0",
    "yaml": "^2.8.4",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "undici": "^8.2.0",
    "vitest": "^3.0.0"
  },
  "optionalDependencies": {
    "undici": "^7.25.0"
  }
}
